<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>QR Code Generator — Fast, Free & Server-Side</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.ico">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <style>
        :root {
            --primary: #ED1703;
            --primary-light: #FF4A38;
            --primary-dark: #c81202;
            --accent: #6C63FF;
            --ink: #14152b;
            --ink-soft: #5a5d75;
            --line: #e9ebf3;
            --surface: #ffffff;
            --surface-2: #f6f7fb;
            --success: #18a957;
            --radius: 18px;
            --radius-sm: 12px;
            --shadow-sm: 0 1px 2px rgba(20, 21, 43, 0.06);
            --shadow: 0 18px 48px -24px rgba(20, 21, 43, 0.30);
            --ring: 0 0 0 4px rgba(237, 23, 3, 0.12);
            --transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            min-height: 100vh;
            color: var(--ink);
            background:
                radial-gradient(900px 600px at 100% -10%, rgba(108, 99, 255, 0.10), transparent 60%),
                radial-gradient(800px 500px at -10% 10%, rgba(237, 23, 3, 0.08), transparent 55%),
                #fbfbfe;
            -webkit-font-smoothing: antialiased;
        }

        /* ===== NAVBAR ===== */
        .navbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px clamp(20px, 5vw, 56px);
            background: rgba(255, 255, 255, 0.72);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--line);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 19px;
            letter-spacing: -0.3px;
            color: var(--ink);
        }

        .brand .logo {
            display: grid;
            place-items: center;
            width: 40px;
            height: 40px;
            border-radius: 11px;
            background: linear-gradient(135deg, var(--primary), var(--primary-light));
            color: #fff;
            font-size: 18px;
            box-shadow: 0 8px 18px -8px rgba(237, 23, 3, 0.6);
        }

        .brand .accent {
            color: var(--primary);
        }

        .nav-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 600;
            color: var(--ink-soft);
            padding: 8px 14px;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: var(--surface);
        }

        .nav-pill .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--success);
            box-shadow: 0 0 0 4px rgba(24, 169, 87, 0.15);
        }

        /* ===== HERO ===== */
        .hero {
            text-align: center;
            padding: 48px 20px 8px;
            max-width: 720px;
            margin: 0 auto;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--primary);
            background: rgba(237, 23, 3, 0.07);
            padding: 7px 14px;
            border-radius: 999px;
            margin-bottom: 18px;
        }

        .hero h1 {
            font-size: clamp(30px, 5vw, 46px);
            line-height: 1.08;
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 14px;
        }

        .hero h1 .grad {
            background: linear-gradient(120deg, var(--primary), var(--accent));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero p {
            font-size: 16px;
            color: var(--ink-soft);
            line-height: 1.6;
        }

        /* ===== LAYOUT ===== */
        .main {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 28px;
            align-items: start;
            max-width: 1040px;
            margin: 0 auto;
            padding: 36px clamp(20px, 5vw, 40px) 64px;
        }

        @media (max-width: 900px) {
            .main {
                grid-template-columns: 1fr;
            }
        }

        .card {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: clamp(24px, 4vw, 34px);
        }

        .card-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 19px;
            font-weight: 700;
            letter-spacing: -0.3px;
            margin-bottom: 4px;
        }

        .card-title i {
            color: var(--primary);
        }

        .card-sub {
            font-size: 14px;
            color: var(--ink-soft);
            margin-bottom: 26px;
        }

        /* ===== FORM ===== */
        .qr-form {
            display: flex;
            flex-direction: column;
            gap: 22px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .form-group > label {
            font-weight: 600;
            font-size: 14px;
            color: var(--ink);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .form-group > label i {
            color: var(--primary);
            font-size: 13px;
        }

        .input-group {
            position: relative;
        }

        .input-group > i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--ink-soft);
            font-size: 15px;
            pointer-events: none;
        }

        .form-control {
            width: 100%;
            padding: 14px 16px;
            border-radius: var(--radius-sm);
            border: 1.5px solid var(--line);
            outline: none;
            font-size: 15px;
            color: var(--ink);
            background: var(--surface-2);
            transition: var(--transition);
        }

        .input-group .form-control {
            padding-left: 44px;
        }

        .form-control::placeholder {
            color: #a3a6bb;
        }

        .form-control:focus {
            border-color: var(--primary);
            background: var(--surface);
            box-shadow: var(--ring);
        }

        select.form-control {
            appearance: none;
            cursor: pointer;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235a5d75' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 16px center;
            background-size: 18px;
        }

        /* size segmented control */
        .seg {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        .seg input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .seg label {
            text-align: center;
            padding: 12px 8px;
            border: 1.5px solid var(--line);
            border-radius: var(--radius-sm);
            background: var(--surface-2);
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            color: var(--ink-soft);
            transition: var(--transition);
        }

        .seg label small {
            display: block;
            font-size: 11px;
            font-weight: 500;
            opacity: 0.7;
            margin-top: 2px;
        }

        .seg input:checked + label {
            border-color: var(--primary);
            background: rgba(237, 23, 3, 0.06);
            color: var(--primary);
            box-shadow: var(--shadow-sm);
        }

        /* color picker */
        .color-row {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .color-swatch {
            position: relative;
            width: 56px;
            height: 48px;
            border-radius: var(--radius-sm);
            border: 1.5px solid var(--line);
            overflow: hidden;
            flex-shrink: 0;
        }

        .color-swatch input[type="color"] {
            position: absolute;
            inset: -6px;
            width: calc(100% + 12px);
            height: calc(100% + 12px);
            border: none;
            padding: 0;
            cursor: pointer;
            background: transparent;
        }

        .swatches {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .swatches button {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            border: 2px solid #fff;
            box-shadow: 0 0 0 1px var(--line);
            cursor: pointer;
            transition: var(--transition);
        }

        .swatches button:hover {
            transform: scale(1.12);
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 15px 18px;
            border-radius: var(--radius-sm);
            border: none;
            cursor: pointer;
            font-size: 15px;
            font-weight: 700;
            transition: var(--transition);
            width: 100%;
        }

        .btn-primary {
            color: #fff;
            background: linear-gradient(120deg, var(--primary), var(--primary-light));
            box-shadow: 0 14px 26px -12px rgba(237, 23, 3, 0.7);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 18px 30px -12px rgba(237, 23, 3, 0.8);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .btn[disabled] {
            opacity: 0.55;
            cursor: not-allowed;
            transform: none !important;
            box-shadow: none;
        }

        .btn-ghost {
            background: var(--surface-2);
            color: var(--ink);
            border: 1.5px solid var(--line);
        }

        .btn-ghost:hover {
            border-color: var(--primary);
            color: var(--primary);
        }

        /* ===== STATUS ===== */
        .form-status {
            display: none;
            align-items: center;
            gap: 9px;
            padding: 13px 16px;
            border-radius: var(--radius-sm);
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .form-status.show {
            display: flex;
        }

        .form-status.success {
            background: rgba(24, 169, 87, 0.10);
            color: var(--success);
        }

        .form-status.error {
            background: rgba(237, 23, 3, 0.10);
            color: var(--primary);
        }

        /* ===== PREVIEW ===== */
        .preview-stage {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 320px;
            border-radius: var(--radius);
            background:
                linear-gradient(var(--surface-2), var(--surface-2)) padding-box,
                repeating-conic-gradient(#eef0f7 0% 25%, #fff 0% 50%) 0 / 22px 22px;
            border: 1.5px dashed var(--line);
            padding: 28px;
            margin-bottom: 22px;
            overflow: hidden;
        }

        .placeholder {
            text-align: center;
            color: var(--ink-soft);
        }

        .placeholder .ico {
            display: grid;
            place-items: center;
            width: 76px;
            height: 76px;
            margin: 0 auto 16px;
            border-radius: 20px;
            background: var(--surface);
            border: 1px solid var(--line);
            font-size: 32px;
            color: #c2c5d6;
        }

        .placeholder h3 {
            font-size: 16px;
            color: var(--ink);
            margin-bottom: 6px;
        }

        .placeholder p {
            font-size: 13.5px;
            max-width: 240px;
            margin: 0 auto;
            line-height: 1.5;
        }

        .qr-frame {
            display: none;
            background: #fff;
            padding: 18px;
            border-radius: 16px;
            box-shadow: var(--shadow);
            animation: pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .qr-frame img {
            display: block;
            width: 240px;
            max-width: 60vw;
            height: auto;
            border-radius: 8px;
        }

        /* spinner overlay */
        .loading {
            position: absolute;
            inset: 0;
            display: none;
            flex-direction: column;
            gap: 14px;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.78);
            backdrop-filter: blur(3px);
            color: var(--ink-soft);
            font-size: 13.5px;
            font-weight: 600;
        }

        .loading.show {
            display: flex;
        }

        .spinner {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: 4px solid var(--line);
            border-top-color: var(--primary);
            animation: spin 0.8s linear infinite;
        }

        .preview-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        @media (max-width: 420px) {
            .preview-actions {
                grid-template-columns: 1fr;
            }
        }

        /* feature chips */
        .features {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
            padding: 4px 20px 56px;
        }

        .chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 600;
            color: var(--ink-soft);
            background: var(--surface);
            border: 1px solid var(--line);
            padding: 9px 15px;
            border-radius: 999px;
            box-shadow: var(--shadow-sm);
        }

        .chip i {
            color: var(--primary);
        }

        /* ===== WIDGETS SECTION ===== */
        .section {
            max-width: 1040px;
            margin: 0 auto;
            padding: 0 clamp(20px, 5vw, 40px);
        }

        .section-head {
            text-align: center;
            margin-bottom: 26px;
        }

        .section-head h2 {
            font-size: clamp(22px, 3.5vw, 30px);
            font-weight: 800;
            letter-spacing: -0.6px;
        }

        .section-head p {
            color: var(--ink-soft);
            font-size: 14.5px;
            margin-top: 6px;
        }

        /* stats widget */
        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-bottom: 56px;
        }

        @media (max-width: 640px) {
            .stats { grid-template-columns: 1fr; }
        }

        .stat {
            position: relative;
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow-sm);
            padding: 26px 24px;
            overflow: hidden;
        }

        .stat::after {
            content: '';
            position: absolute;
            inset: 0 0 auto 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary), var(--accent));
        }

        .stat .ico {
            display: grid;
            place-items: center;
            width: 46px;
            height: 46px;
            border-radius: 13px;
            background: rgba(237, 23, 3, 0.08);
            color: var(--primary);
            font-size: 19px;
            margin-bottom: 16px;
        }

        .stat .num {
            font-size: 30px;
            font-weight: 800;
            letter-spacing: -1px;
            line-height: 1;
        }

        .stat .lbl {
            font-size: 13.5px;
            color: var(--ink-soft);
            font-weight: 600;
            margin-top: 6px;
        }

        /* how it works widget */
        .steps {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-bottom: 56px;
        }

        @media (max-width: 760px) {
            .steps { grid-template-columns: 1fr; }
        }

        .step {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow-sm);
            padding: 28px 24px;
        }

        .step .badge {
            display: grid;
            place-items: center;
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--primary), var(--primary-light));
            color: #fff;
            font-weight: 800;
            font-size: 16px;
            margin-bottom: 16px;
            box-shadow: 0 10px 20px -10px rgba(237, 23, 3, 0.7);
        }

        .step h3 {
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .step p {
            font-size: 14px;
            color: var(--ink-soft);
            line-height: 1.6;
        }

        /* recent widget */
        .recent-wrap {
            margin-bottom: 56px;
        }

        .recent {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 14px;
        }

        @media (max-width: 760px) {
            .recent { grid-template-columns: repeat(3, 1fr); }
        }

        @media (max-width: 420px) {
            .recent { grid-template-columns: repeat(2, 1fr); }
        }

        .recent-item {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius-sm);
            padding: 12px;
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
        }

        .recent-item:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow);
            border-color: rgba(237, 23, 3, 0.3);
        }

        .recent-item img {
            display: block;
            width: 100%;
            aspect-ratio: 1;
            object-fit: contain;
            border-radius: 8px;
            background: var(--surface-2);
        }

        .recent-item span {
            display: block;
            font-size: 11px;
            color: var(--ink-soft);
            margin-top: 8px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .recent-empty {
            grid-column: 1 / -1;
            text-align: center;
            color: var(--ink-soft);
            font-size: 14px;
            padding: 36px;
            border: 1.5px dashed var(--line);
            border-radius: var(--radius-sm);
            background: var(--surface-2);
        }

        /* ===== FOOTER ===== */
        footer {
            border-top: 1px solid var(--line);
            background: var(--surface);
            margin-top: 24px;
        }

        .footer-inner {
            max-width: 1040px;
            margin: 0 auto;
            padding: 44px clamp(20px, 5vw, 40px) 28px;
            display: grid;
            grid-template-columns: 1.4fr 1fr 1fr;
            gap: 36px;
        }

        @media (max-width: 700px) {
            .footer-inner { grid-template-columns: 1fr; gap: 28px; }
        }

        .footer-brand .brand {
            margin-bottom: 12px;
        }

        .footer-brand p {
            font-size: 13.5px;
            color: var(--ink-soft);
            line-height: 1.6;
            max-width: 300px;
        }

        .footer-social {
            display: flex;
            gap: 10px;
            margin-top: 16px;
        }

        .footer-social a {
            display: grid;
            place-items: center;
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: var(--surface-2);
            border: 1px solid var(--line);
            color: var(--ink-soft);
            transition: var(--transition);
        }

        .footer-social a:hover {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
            transform: translateY(-2px);
        }

        .footer-col h4 {
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--ink);
            margin-bottom: 14px;
        }

        .footer-col a {
            display: block;
            font-size: 14px;
            color: var(--ink-soft);
            text-decoration: none;
            padding: 5px 0;
            transition: var(--transition);
        }

        .footer-col a:hover {
            color: var(--primary);
            padding-left: 4px;
        }

        .footer-bottom {
            border-top: 1px solid var(--line);
            padding: 18px clamp(20px, 5vw, 40px);
            text-align: center;
            font-size: 13px;
            color: var(--ink-soft);
        }

        .footer-bottom .accent { color: var(--primary); font-weight: 600; }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        @keyframes pop {
            from { opacity: 0; transform: scale(0.9); }
            to { opacity: 1; transform: scale(1); }
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="brand">
            <span class="logo"><i class="fas fa-qrcode"></i></span>
            <span>QR<span class="accent">Forge</span></span>
        </div>
        <span class="nav-pill"><span class="dot"></span> Server-side ready</span>
    </nav>

    <!-- HERO -->
    <header class="hero">
        <span class="eyebrow"><i class="fas fa-bolt"></i> Free QR Generator</span>
        <h1>Turn any link into a <span class="grad">scannable QR code</span></h1>
        <p>Pick a size, choose a color, and download a crisp PNG in seconds — generated securely on the server.</p>
    </header>

    <!-- MAIN -->
    <main class="main">
        <!-- FORM CARD -->
        <section class="card">
            <h2 class="card-title"><i class="fas fa-sliders"></i> Customize</h2>
            <p class="card-sub">Enter your destination and style the code to match your brand.</p>

            <div id="formStatus" class="form-status"></div>

            <form id="qrForm" class="qr-form" method="POST" action="/api/generate-qr">
                <!-- Content -->
                <div class="form-group">
                    <label for="content"><i class="fas fa-link"></i> Destination URL</label>
                    <div class="input-group">
                        <i class="fas fa-globe"></i>
                        <input type="text" id="content" name="url" class="form-control"
                            placeholder="https://example.com" required>
                    </div>
                </div>

                <!-- Size -->
                <div class="form-group">
                    <label><i class="fas fa-up-right-and-down-left-from-center"></i> Size</label>
                    <div class="seg">
                        <input type="radio" id="s200" name="size" value="200">
                        <label for="s200">Small<small>200px</small></label>
                        <input type="radio" id="s300" name="size" value="300" checked>
                        <label for="s300">Medium<small>300px</small></label>
                        <input type="radio" id="s400" name="size" value="400">
                        <label for="s400">Large<small>400px</small></label>
                    </div>
                </div>

                <!-- Color -->
                <div class="form-group">
                    <label for="color"><i class="fas fa-palette"></i> Foreground color</label>
                    <div class="color-row">
                        <span class="color-swatch">
                            <input type="color" id="color" name="color" value="#14152b">
                        </span>
                        <div class="swatches" id="swatches">
                            <button type="button" data-c="#14152b" style="background:#14152b"></button>
                            <button type="button" data-c="#ED1703" style="background:#ED1703"></button>
                            <button type="button" data-c="#6C63FF" style="background:#6C63FF"></button>
                            <button type="button" data-c="#18a957" style="background:#18a957"></button>
                            <button type="button" data-c="#0d6efd" style="background:#0d6efd"></button>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary" id="generateBtn">
                    <i class="fas fa-wand-magic-sparkles"></i> Generate QR Code
                </button>
            </form>
        </section>

        <!-- PREVIEW CARD -->
        <section class="card">
            <h2 class="card-title"><i class="fas fa-eye"></i> Preview</h2>
            <p class="card-sub">Your generated QR code appears here, ready to download.</p>

            <div class="preview-stage">
                <div class="placeholder" id="placeholder">
                    <div class="ico"><i class="fas fa-qrcode"></i></div>
                    <h3>Nothing here yet</h3>
                    <p>Fill out the form and hit generate to see your code.</p>
                </div>

                <div class="qr-frame" id="qrFrame">
                    <img id="qrcodeimg" src="" alt="Generated QR Code">
                </div>

                <div class="loading" id="loading">
                    <div class="spinner"></div>
                    <span>Generating your code…</span>
                </div>
            </div>

            <div class="preview-actions">
                <button class="btn btn-ghost" id="copyBtn" onclick="copyLink()" disabled>
                    <i class="fas fa-copy"></i> Copy link
                </button>
                <button class="btn btn-primary" id="downloadBtn" onclick="downloadQR()" disabled>
                    <i class="fas fa-download"></i> Download PNG
                </button>
            </div>
        </section>
    </main>

    <!-- FEATURE CHIPS -->
    <div class="features">
        <span class="chip"><i class="fas fa-shield-halved"></i> Secure & private</span>
        <span class="chip"><i class="fas fa-infinity"></i> Unlimited codes</span>
        <span class="chip"><i class="fas fa-image"></i> High-res PNG</span>
        <span class="chip"><i class="fas fa-bolt"></i> Instant generation</span>
    </div>

    <!-- WIDGET 1 — LIVE STATS -->
    <section class="section">
        <div class="stats">
            <div class="stat">
                <div class="ico"><i class="fas fa-qrcode"></i></div>
                <div class="num" id="statTotal"><%= typeof total !== 'undefined' ? total : 0 %></div>
                <div class="lbl">QR codes generated</div>
            </div>
            <div class="stat">
                <div class="ico"><i class="fas fa-bolt"></i></div>
                <div class="num">&lt; 1s</div>
                <div class="lbl">Average generation time</div>
            </div>
            <div class="stat">
                <div class="ico"><i class="fas fa-indian-rupee-sign"></i></div>
                <div class="num">₹0</div>
                <div class="lbl">Cost — free forever</div>
            </div>
        </div>
    </section>

    <!-- WIDGET 2 — HOW IT WORKS -->
    <section class="section">
        <div class="section-head">
            <h2>How it works</h2>
            <p>Three quick steps from a link to a downloadable QR code.</p>
        </div>
        <div class="steps">
            <div class="step">
                <div class="badge">1</div>
                <h3>Paste your URL</h3>
                <p>Drop in any website, profile or link you want people to reach.</p>
            </div>
            <div class="step">
                <div class="badge">2</div>
                <h3>Style it</h3>
                <p>Pick a size and choose a color that matches your brand.</p>
            </div>
            <div class="step">
                <div class="badge">3</div>
                <h3>Download &amp; share</h3>
                <p>Grab a crisp PNG and use it on prints, posters or screens.</p>
            </div>
        </div>
    </section>

    <!-- WIDGET 3 — RECENT QR CODES -->
    <section class="section recent-wrap">
        <div class="section-head">
            <h2>Recently generated</h2>
            <p>The latest codes created on this server.</p>
        </div>
        <div class="recent" id="recentGrid">
            <% if (typeof recent !== 'undefined' && recent.length) { %>
                <% recent.forEach(function (item) { %>
                    <div class="recent-item">
                        <img src="<%= item.qr_path %>" alt="QR code" loading="lazy">
                        <span title="<%= item.request_url %>"><%= item.request_url %></span>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="recent-empty">No QR codes yet — generate your first one above!</div>
            <% } %>
        </div>
    </section>

    <!-- FOOTER -->
    <footer>
        <div class="footer-inner">
            <div class="footer-brand">
                <div class="brand">
                    <span class="logo"><i class="fas fa-qrcode"></i></span>
                    <span>QR<span class="accent">Forge</span></span>
                </div>
                <p>The fast, free and private way to turn any link into a scannable QR code — generated securely on your own server.</p>
                <div class="footer-social">
                    <a href="#" aria-label="GitHub"><i class="fab fa-github"></i></a>
                    <a href="#" aria-label="Twitter"><i class="fab fa-x-twitter"></i></a>
                    <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                </div>
            </div>
            <div class="footer-col">
                <h4>Product</h4>
                <a href="#">Generate QR</a>
                <a href="#">Features</a>
                <a href="#">How it works</a>
                <a href="#">Pricing</a>
            </div>
            <div class="footer-col">
                <h4>Resources</h4>
                <a href="#">Documentation</a>
                <a href="#">API reference</a>
                <a href="#">Privacy policy</a>
                <a href="#">Contact</a>
            </div>
        </div>
        <div class="footer-bottom">
            © <span id="year">2026</span> <span class="accent">QRForge</span> · Built with Node.js &amp; Express
        </div>
    </footer>

    <script>
        const form = document.getElementById('qrForm');
        const generateBtn = document.getElementById('generateBtn');
        const loading = document.getElementById('loading');
        const placeholder = document.getElementById('placeholder');
        const qrFrame = document.getElementById('qrFrame');
        const qrImg = document.getElementById('qrcodeimg');
        const downloadBtn = document.getElementById('downloadBtn');
        const copyBtn = document.getElementById('copyBtn');

        let currentQrUrl = '';

        // Color swatch quick-pick
        document.getElementById('swatches').addEventListener('click', (e) => {
            const btn = e.target.closest('button[data-c]');
            if (!btn) return;
            document.getElementById('color').value = btn.dataset.c;
        });

        form.addEventListener('submit', function (e) {
            e.preventDefault();

            const formData = new FormData(this);
            setLoading(true);

            fetch('/api/generate-qr', { method: 'POST', body: formData })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        displayQRCode(data.qrCodeUrl);
                        showStatus('QR code generated successfully!', 'success');
                        refreshStats();
                    } else {
                        setLoading(false);
                        showStatus(data.error || 'Failed to generate QR code', 'error');
                    }
                })
                .catch(() => {
                    setLoading(false);
                    showStatus('Could not reach the server. Please try again.', 'error');
                });
        });

        function setLoading(state) {
            loading.classList.toggle('show', state);
            generateBtn.disabled = state;
            if (state) {
                generateBtn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Generating…';
            } else {
                generateBtn.innerHTML = '<i class="fas fa-wand-magic-sparkles"></i> Generate QR Code';
            }
        }

        function displayQRCode(qrCodeUrl) {
            currentQrUrl = qrCodeUrl;
            qrImg.onload = () => {
                setLoading(false);
                placeholder.style.display = 'none';
                qrFrame.style.display = 'block';
                downloadBtn.disabled = false;
                copyBtn.disabled = false;
            };
            qrImg.src = qrCodeUrl;
        }

        function showStatus(message, type) {
            const el = document.getElementById('formStatus');
            el.className = `form-status show ${type}`;
            el.innerHTML = `<i class="fas fa-${type === 'success' ? 'circle-check' : 'circle-exclamation'}"></i> ${message}`;
            clearTimeout(el._t);
            el._t = setTimeout(() => { el.className = 'form-status'; el.innerHTML = ''; }, 5000);
        }

        async function copyLink() {
            if (!currentQrUrl) return;
            try {
                await navigator.clipboard.writeText(currentQrUrl);
                flash(copyBtn, '<i class="fas fa-check"></i> Copied!');
            } catch {
                showStatus('Could not copy link', 'error');
            }
        }

        function downloadQR() {
            if (!currentQrUrl) { alert('Generate a QR code first'); return; }
            const link = document.createElement('a');
            link.href = currentQrUrl;
            link.download = 'qr-code.png';
            link.target = '_blank';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function flash(btn, html) {
            const original = btn.innerHTML;
            btn.innerHTML = html;
            setTimeout(() => { btn.innerHTML = original; }, 1600);
        }

        // Refresh the live stats + recent gallery after generating
        async function refreshStats() {
            try {
                const res = await fetch('/api/stats');
                const data = await res.json();

                document.getElementById('statTotal').textContent = data.total;

                const grid = document.getElementById('recentGrid');
                if (data.recent && data.recent.length) {
                    grid.innerHTML = data.recent.map(item => `
                        <div class="recent-item">
                            <img src="${item.qr_path}" alt="QR code" loading="lazy">
                            <span title="${item.request_url}">${item.request_url}</span>
                        </div>`).join('');
                }
            } catch (_) { /* non-critical */ }
        }

        // Footer year
        document.getElementById('year').textContent = new Date().getFullYear();
    </script>

</body>

</html>
